# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local secrets
.venv/
venv/
.env
.env.*
!.env.example

# Editor and OS files
.DS_Store
.idea/
.vscode/

# Runtime state and hardware calibration
data/events.db*
data/snapshots/
data/viewer.json
table_cal.json
table_cal.json.tmp
table_cal_view.png
table_cal_view.png.tmp
table_area.json
laser_cal.json
room_map.json
room_zones.json
camera_intrinsics.json
*.log

# Downloaded/generated model artifacts
models/**/*.pt
models/**/*.engine
models/**/*.onnx
models/**/*.onnx.json
models/**/*.gguf
models/**/*.gguf.part
models/**/*.bin

# spoken-question recordings (people's voices) stay local
tests/stt_audio/*.wav

# TensorRT engine / profile / timing caches (onnxruntime TensorRT EP, core/embed.py)
models/cache/

# Offline container build inputs (downloaded wheels, host libraries copied from the Jetson)
docker/wheels/
docker/libs/

# Third-party source and builds (whisper.cpp is fetched and built by scripts/build_whisper.sh)
third_party/*
!third_party/stt_bench.py

# Training data and runs (large; regenerate with scripts/finetune/)
data/dataset/
data/trials/
runs/

# Experiments: keep only scripts and notes (packages, weights, stock test images and outputs stay local)
experiments/**
!experiments/**/
!experiments/**/*.py
!experiments/**/*.sh
!experiments/**/*.md
experiments/**/pylib/
experiments/**/weights/
experiments/**/frames/

# Stray local session files
*.ses
data/clips/
data/finetune/
data/hands_public/
data/finetune_pub/

# per-device config overlay (core/config.py)
config.local.yaml
data/room/
data/finetune-*/
.pulse-cookie
