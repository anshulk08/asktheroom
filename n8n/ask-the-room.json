      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        400
      ],
      "id": "90f16945-18b1-5e6e-8144-3da12020d631",
      "name": "Get room state",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// /state is {state: world.state_json(), last_answer, server_t}. Hidden objects (INSIDE, UNDER, HELD)\n// are normal during a demo; a lost track, a stalled detector or no internet are worth a look.\nconst s = $json.state || {};\nconst problems = [];\nif ((s.fps || 0) < 10) problems.push(`perception at ${s.fps || 0} fps (want 10+): is the detector running?`);\nif (!s.online) problems.push('rig is offline: answers use templates and Piper, no Grok or ElevenLabs');\nconst lost = (s.entities || []).filter(e => e.status === 'UNKNOWN').map(e => e.name);\nif (lost.length) problems.push(`lost track of: ${lost.join(', ')}`);\nconst gone = (s.entities || []).filter(e => e.status === 'GONE').map(e => `${e.name} (${e.edge || 'edge'})`);\nif (gone.length) problems.push(`left the table: ${gone.join(', ')}`);\nreturn [{ json: { ok: problems.length === 0, problems, fps: s.fps, online: s.online,\n                  checked: new Date().toISOString() } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        320
      ],
      "id": "2a316cb9-49f3-5db7-9d8e-ea4ee9b2602c",
      "name": "Check the room"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "5509f3a4-f187-507c-bf75-2c4085cc2e1b",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1180,
        320
      ],
      "id": "8e715af3-cbd5-56c7-815f-9fc03bfb6d3b",
      "name": "Problems?"
